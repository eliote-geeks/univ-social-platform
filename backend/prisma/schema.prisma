generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Rôle global du site, distinct des rôles au sein d'un groupe (GroupRole) ou d'une conversation
// (ConversationRole). Embarqué dans le JWT d'accès (15 min de validité) : un changement de rôle
// met donc jusqu'à 15 min à se propager, compromis jugé acceptable pour éviter une lecture DB
// systématique sur chaque requête protégée par RolesGuard.
enum SiteRole {
  USER
  MODERATOR
  ADMIN
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum NotificationType {
  REACTION
  COMMENT
  FOLLOW
  MENTION
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  username      String        @unique
  passwordHash  String
  displayName   String
  bio           String?       @db.VarChar(500)
  avatarUrl     String?
  coverUrl      String?
  status        AccountStatus @default(ACTIVE)
  role          SiteRole      @default(USER)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  reactions     Reaction[]
  following     Follow[]      @relation("following")
  followers     Follow[]      @relation("followers")
  notificationsReceived Notification[] @relation("notificationsReceived")
  notificationsSent     Notification[] @relation("notificationsSent")
  conversations ConversationParticipant[]
  messages      Message[]
  groupsCreated Group[]         @relation("groupCreator")
  groupMemberships GroupMember[]
  pagesOwned    Page[]          @relation("pageOwner")
  pageFollows   PageFollower[]
  eventsCreated Event[]         @relation("eventCreator")
  eventRsvps    EventAttendee[]
  reportsFiled    Report[] @relation("reportsFiled")
  reportsReviewed Report[] @relation("reportsReviewed")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?  @db.VarChar(512)
  ipAddress        String?  @db.VarChar(64)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Post {
  id          String         @id @default(cuid())
  authorId    String
  body        String?        @db.VarChar(5000)
  visibility  PostVisibility @default(PUBLIC)
  // Rattachement optionnel : un post "normal" a groupId=pageId=null. Jamais renseignés depuis
  // le DTO public POST /posts — uniquement par GroupsService/PagesService après vérification
  // d'appartenance/propriété, pour qu'un client ne puisse pas s'auto-publier dans un groupe.
  groupId     String?
  pageId      String?
  publishedAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  page        Page?          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  comments    Comment[]
  reactions   Reaction[]
  notifications Notification[]
  @@index([publishedAt])
  @@index([authorId, publishedAt])
  @@index([groupId, publishedAt])
  @@index([pageId, publishedAt])
}

model PostMedia {
  id        String    @id @default(cuid())
  postId    String
  type      MediaType
  url       String
  altText   String?   @db.VarChar(250)
  width     Int?
  height    Int?
  sortOrder Int       @default(0)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, sortOrder])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String    @db.VarChar(2000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("comment_replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("comment_replies")
  notifications Notification[]
  @@index([postId, createdAt])
}

model Reaction {
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String
  type        NotificationType
  postId      String?
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("notificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User             @relation("notificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Conversation {
  id            String                     @id @default(cuid())
  isGroup       Boolean                    @default(false)
  title         String?                    @db.VarChar(120)
  // Rafraîchi à chaque nouveau message ; sert de clé de tri pour la liste des conversations
  // (évite un ORDER BY sur MAX(message.createdAt) coûteux à chaque requête).
  lastMessageAt DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  participants  ConversationParticipant[]
  messages      Message[]
  @@index([lastMessageAt])
}

enum ConversationRole {
  OWNER
  MEMBER
}

model ConversationParticipant {
  conversationId String
  userId         String
  // OWNER uniquement pertinent pour les conversations de groupe : gère les membres et le
  // titre. Sur une conversation directe (1:1) tout le monde reste MEMBER, il n'y a rien à gérer.
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime     @default(now())
  // Position de lecture de l'utilisateur : tout message postérieur est considéré non lu.
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String       @db.VarChar(4000)
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

model Group {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String          @db.VarChar(100)
  description String?         @db.VarChar(1000)
  visibility  GroupVisibility @default(PUBLIC)
  coverUrl    String?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User            @relation("groupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]
  posts       Post[]
  events      Event[]
  @@index([visibility, createdAt])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([groupId, userId])
  @@index([userId])
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(1000)
  category    String?  @db.VarChar(60)
  avatarUrl   String?
  coverUrl    String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User           @relation("pageOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  followers   PageFollower[]
  posts       Post[]
  events      Event[]
  @@index([createdAt])
}

model PageFollower {
  pageId     String
  userId     String
  followedAt DateTime @default(now())
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([pageId, userId])
  @@index([userId])
}

enum EventRsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

model Event {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(150)
  description String?   @db.VarChar(3000)
  location    String?   @db.VarChar(250)
  onlineUrl   String?
  startAt     DateTime
  endAt       DateTime?
  coverUrl    String?
  // Un événement appartient au plus à l'un des deux (jamais les deux) ; ni l'un ni l'autre
  // pour un événement autonome créé directement par un utilisateur.
  groupId     String?
  pageId      String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  page        Page?           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy   User            @relation("eventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  attendees   EventAttendee[]
  @@index([startAt])
  @@index([groupId])
  @@index([pageId])
}

model EventAttendee {
  eventId     String
  userId      String
  status      EventRsvpStatus @default(GOING)
  respondedAt DateTime        @default(now())
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  GROUP
  PAGE
  EVENT
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
}

model Report {
  id           String           @id @default(cuid())
  reporterId   String
  // Cible polymorphe : pas de FK réelle (le type de table dépend de targetType), l'existence de
  // la cible est vérifiée en code dans ModerationService.fileReport avant création.
  targetType   ReportTargetType
  targetId     String
  reason       String           @db.VarChar(500)
  status       ReportStatus     @default(PENDING)
  resolution   String?          @db.VarChar(500)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  reporter     User  @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("reportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([status, createdAt])
  @@index([targetType, targetId])
}
